{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "game-web",
      "runtimeExecutable": "tools/dev-web.sh",
      "runtimeArgs": [
        "--app",
        "game",
        "--release"
      ],
      "port": 8733
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "preview",
        "--",
        "--port",
        "4173"
      ],
      "port": 4173,
      "url": "http://localhost:4173"
    },
    {
      "name": "api-docs",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8740",
        "--bind",
        "127.0.0.1",
        "--directory",
        "target/api/doc"
      ],
      "port": 8740
    }
  ]
}