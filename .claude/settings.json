{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "game-frame": {
      "source": {
        "source": "github",
        "repo": "tanepiper/game-frame"
      }
    }
  },
  "enabledPlugins": {
    "gameframe@game-frame": true
  },
  "permissions": {
    "allow": [
      "Bash(tools/gf.sh *)",
      "Bash(tools/test/run.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(git add -A *)",
      "Bash(git add . *)",
      "Bash(git commit -a *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git add -A)",
      "Bash(git add .)",
      "Bash(git commit -am *)"
    ]
  }
}
