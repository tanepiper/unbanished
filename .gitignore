# Original game data and anything derived from it. Never commit these.
# Populate locally with tools/extract-assets.sh.
/game-data/
*.pkg
*.pkm
*.crs
*.rsc
*.str
*.sav

# The player's save games. Local only.
/save-game/

# The emulated PC that runs the original (tools/live/emupc.py in GameFrame). Local only.
/derived/

# Decompiler output reproduces the original program code. Local only.
# Populate with tools/ghidra/export.sh.
/analysis/

# Original binaries
*.exe
*.dll

# Tooling
__pycache__/
*.pyc
.venv/
# Local tool paths (tools/re-setup.sh writes them)
/.env
.DS_Store

# Rust
/target/
/dist/

# Example rule-hook mods build on their own.
/examples/**/target/
/apps/frame/target/
/examples/**/Cargo.lock
# Links into the GameFrame home (games/ID/): never commit them
/game
/media
/saves
/analysis
/derived
/game-data
/save-game
