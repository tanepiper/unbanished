{
  "name": "Un-Banished",
  "id": "dev.unbanished.game",
  "version": "0.6.0",
  "icon": "apps/game/pwa/icon-512.png",
  "vanilla": {
    "build": [
      ["cargo", "build", "--release", "-p", "unbanished-app", "--no-default-features", "--features", "unstable-frame"],
      ["cargo", "build", "--release", "--manifest-path", "apps/frame/Cargo.toml"]
    ],
    "programs": ["target/release/unbanished", "apps/frame/target/release/unbanished-frame"],
    "start": "unbanished-frame",
    "args": ["--data", "{data}"]
  },
  "extra": {
    "name": "Un-Banished More",
    "build": [
      ["cargo", "build", "--release", "-p", "unbanished-app", "--features", "unstable-frame"],
      ["cargo", "build", "--release", "--manifest-path", "apps/frame/Cargo.toml"]
    ]
  }
}
